+static void shared_widget_selection()
+{
+    TargetSpec second;
+    second.name = "track"; second.remember = true;
+    second.slot = 43100301; second.content = 43204002; second.scene_id = 0x4d4755000003;
+    second.width = 2240; second.height = 896;
+    {
+        Rig r; r.port.set_widget_restore(true); r.m.add(second);
+        r.offered(1); r.offered(2);
+        ContentArea area; area.has_layout = true; area.layout = 4;
+        r.port.on_size(kWidget, area, r.now);
+        r.port.on_size(second.content, area, r.now);
+        r.port.on_show(kWidget, r.now); calls.clear();
+        r.port.on_release(kWidget, r.now);
+        r.port.on_show(second.content, r.now);
+        r.port.dispatch(r.now);
+        ok("selecting the second widget cancels the first retained request",
+           calls_are("focus 43204002; unfocus 43204001"));
+        r.port.on_release(second.content, r.now);
+        r.port.on_widget_wake(r.now);
+        r.now += 300; r.port.dispatch(r.now);
+        ok("a wake restores only the last selected widget in that layout",
+           calls_are("unfocus 43204002; focus 43204002"));
+        r.port.on_show(second.content, r.now);
+        r.port.on_release(second.content, r.now);
+        area.layout = 5;
+        r.port.on_size(kWidget, area, r.now);
+        r.port.on_size(second.content, area, r.now);
+        r.port.dispatch(r.now); calls.clear();
+        r.port.on_show(kWidget, r.now); calls.clear();
+        r.port.on_release(kWidget, r.now);
+        area.layout = 4;
+        r.port.on_size(kWidget, area, r.now);
+        r.port.on_size(second.content, area, r.now);
+        r.port.dispatch(r.now); calls.clear();
+        r.now += 300; r.port.dispatch(r.now);
+        ok("normal and M layouts keep independent component choices", calls_are("focus 43204002"));
+    }
+    char path[] = "/tmp/crs-widget-memory-XXXXXX";
+    const int fd = mkstemp(path);
+    close(fd);
+    {
+        Rig r; r.port.load_widget_selection(path); r.port.set_widget_restore(true); r.offered(1);
+        ContentArea area; area.has_layout = true; area.layout = 4;
+        r.port.on_size(kWidget, area, r.now);
+        r.port.on_show(kWidget, r.now);
+        calls.clear();
+    }
+    {
+        Rig r; r.port.load_widget_selection(path); r.port.set_widget_restore(true); r.offered(1);
+        ContentArea area; area.has_layout = true; area.layout = 4;
+        r.port.on_size(kWidget, area, r.now);
+        r.now += 300; r.port.dispatch(r.now);
+        ok("a fresh service restores persisted selection after first layout report",
+           calls_are("focus 43204001"));
+        r.now += 8000; r.port.dispatch(r.now);
+        ok("persisted startup selection waits through the factory prompt", calls_are(""));
+        r.port.on_availability(false, r.now);
+        r.port.on_availability(true, r.now);
+        r.now += 1500;
+        r.offered(1); r.port.on_size(kWidget, area, r.now);
+        r.now += 300; r.port.dispatch(r.now);
+        ok("provider reconnect retains the selected component", calls_are("focus 43204001"));
+    }
+    unlink(path);
+}
