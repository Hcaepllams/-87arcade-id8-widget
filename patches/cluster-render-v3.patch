+
+void Dcsm27Port::save_widget_selection() const
+{
+    if (selection_path_.empty())
+        return;
+    std::ostringstream text;
+    for (const auto &kv : selections_)
+        text << kv.first << ' ' << kv.second << '\n';
+    const std::string data = text.str(), tmp = selection_path_ + ".tmp";
+    const int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    const bool whole = fd >= 0 && write(fd, data.data(), data.size()) == (ssize_t)data.size() && fsync(fd) == 0;
+    if (fd >= 0) close(fd);
+    if (!whole || rename(tmp.c_str(), selection_path_.c_str()) != 0) {
+        unlink(tmp.c_str());
+        log_warn("widget-restore: cannot save selection to %s", selection_path_.c_str());
+        return;
+    }
+    const std::string dir = selection_path_.substr(0, selection_path_.find_last_of('/') + 1);
+    const int dfd = open(dir.empty() ? "." : dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dfd >= 0) {
+        fsync(dfd);
+        close(dfd);
+    }
+}
